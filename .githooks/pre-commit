#!/bin/sh
# 仮説検証Wiki の不変ルールをコミット時に強制する。
# 有効化: git config core.hooksPath .githooks（Claude Code は SessionStart フックが自動設定）
set -e

# 1) tools/tests を変更したときだけユニットテスト
if git diff --cached --name-only | grep -qE '^(tools|tests)/'; then
  python3 -m unittest discover -s tests || exit 1
fi

# 2) ontology.yaml を触ったら生成物（人間可読 ontology.md・機械可読 schema/*.schema.json）の
#    再生成漏れを弾く（SSoT ドリフト防止）。テストの鮮度チェックは tools/tests を staged した
#    ときだけ走るので、ontology.yaml 単独編集の穴を塞ぐ。
if git diff --cached --name-only | grep -qx 'ontology.yaml'; then
  python3 tools/gen_ontology_doc.py --check || exit 1
  python3 tools/gen_schema.py --check || exit 1
fi

# 2b) 雛形と fields 宣言のドリフト（雛形に宣言済みキーが無い／宣言に無いキーがある）。
#     雛形は人が書く説明を含むので生成しない。照合だけする。
if git diff --cached --name-only | grep -qE '^(ontology\.yaml|templates/)'; then
  python3 tools/gen_schema.py --check-templates || exit 1
fi

# 3) 決定論 lint（全プロジェクト）
python3 tools/hwlint.py --all || exit 1

# 4) テストカード不変（学習カード記入済み TEST の成功基準書き換え検出）
python3 tools/check_testcard_immutable.py --staged || exit 1

# 5) log.md は追記のみ（既存行の書き換えを禁止）。--diff-filter=M で「改変」だけを見る。
#    ファイルごとの削除（案件まるごと廃止）は対象外＝許可。
if git diff --cached -U0 --diff-filter=M -- 'projects/*/wiki/log.md' | grep -qE '^-[^-]'; then
  echo "[error] log-append-only | projects/*/wiki/log.md の既存行が書き換えられている（不変ルール3）" >&2
  exit 1
fi

# 6) sources/ は不変層（既存ファイルの中身の書き換えを禁止）。--diff-filter=M で「改変」だけを見る。
#    新規追加（/learning の初回配置）と、削除（誤配置の除去・案件まるごと廃止）は許可。
#    不変性の要は「観測した生データを後から書き換えない」こと。削除は git 上で可視なので許容する。
#    README.md は不変層の**説明文**であって観測データでないので対象外（雛形を直したとき既存案件の
#    README が陳腐化したまま凍結されるのを避ける。tools/hooks/guard_sources.py と同じ扱い）。
if git diff --cached --name-only --diff-filter=M -- 'projects/*/sources/*' \
   | grep -v '/sources/README\.md$' | grep -q .; then
  echo "[error] sources-immutable | projects/*/sources/ の既存ファイルが書き換えられている（不変層）" >&2
  exit 1
fi
